---
import SectionHeader from "./ui/SectionHeader.astro";

const features = [
  {
    number: "01",
    title: "Tradição",
    description:
      "Mais de 40 anos dedicados à formação de alunos com excelência, sensibilidade artística e paixão pela dança.",
  },
  {
    number: "02",
    title: "Método",
    description:
      "Uma metodologia exclusiva que une técnica apurada, expressão artística e desenvolvimento individual em cada etapa.",
  },
  {
    number: "03",
    title: "Ambiente",
    description:
      "Estrutura sofisticada, acolhedora e cuidadosamente projetada para proporcionar conforto, bem-estar e inspiração.",
  },
  {
    number: "04",
    title: "Experiência",
    description:
      "Muito além das aulas: vivências únicas, espetáculos marcantes e momentos que permanecem para toda a vida.",
  },
];
---

<section id="por-que" class="py-20 lg:py-28">
  <div class="mx-auto max-w-7xl xl:container px-6 space-y-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16" data-animate="reveal">
      <div>
        <SectionHeader
          eyebrow="Mais do que uma escola de dança  "
          title="A escolha de quem valoriza excelência"
          align="left"
          titleSize="large"
        />
      </div>
      <div>
        <p
          class="mx-auto mt-4 max-w-2xl text-base lg:text-lg xl:text-xl text-neutral-600 leading-relaxed"
        >
          Há mais de quarenta anos, somos sinônimo de tradição em Porto Alegre.
          Ao longo dessa trajetória, desenvolvemos uma metodologia própria que
          nos consolidou como referência nacional no ensino da dança. Mais do
          que uma escola: oferecemos uma experiência completa, onde tradição,
          excelência e um ambiente pensado se unem para promover a evolução de
          cada aluno.
        </p>
      </div>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((feature, index) => (
          <div
            class="feature-card bg-white border-1 border-neutral-200 p-8 lg:p-10 flex flex-col justify-start min-h-[260px] fadeIn"
            data-animate="fadeInUp"
            data-animate-delay={index * 0.3}
          >
            <div class="flex items-center gap-4">
              <span class="text-sm text-neutral-400 font-medium">
                {feature.number}
              </span>
              <div class="h-px flex-1 bg-neutral-100" />
            </div>

            <div class="mt-10">
              <h3 class="text-lg xl:text-xl font-medium text-primary">
                {feature.title}
              </h3>

              <p class="mt-3 text-neutral-600 text-base leading-relaxed">
                {feature.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .fadeIn {
    opacity: 0;
  }
  .fadeIn.trig {
    animation: fadeIn 1s ease-in-out forwards;
    animation-delay: var(--trig-delay, 0ms); 
  }
  @keyframes fadeIn {
    0% {
      opacity: 0;
      transform: translateY(16px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

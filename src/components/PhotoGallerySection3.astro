---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Section from "./ui/Section.astro";
import SectionHeader from "./ui/SectionHeader.astro";

interface Photo {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  description?: string;
}

interface Props {
  photos: Photo[];
  cols?: number;
  background?: "white" | "neutral" | "dark" | "primary";
  aspect?: "4/3" | "3/4" | "16/9" | "9/16" | "1/1" | "3/2" | "2/3";
  eyebrow?: string;
  title?: string;
  description?: string;
  align?: "left" | "center" | "right";
  galleryId: string;
  autoplayDelay?: number;
  loop?: boolean;
  spaceBetween?: number;
}

const {
  photos,
  aspect = "4/3",
  cols: colsProp = 3,
  background = "white",
  eyebrow,
  title,
  description,
  align = "left",
  galleryId,
  autoplayDelay = 4000,
  loop = true,
  spaceBetween = 16,
} = Astro.props;

const cols = Math.max(1, colsProp);
const id = `gallery-${galleryId}`;

const getSrc = (src: ImageMetadata | string): string =>
  typeof src === "string" ? src : src.src;

const navThemes = {
  white:   { button: "border-neutral-200 text-neutral-700 hover:bg-neutral-100", dotInactive: "#d4d4d8", dotActive: "var(--color-primary)" },
  neutral: { button: "border-neutral-200 text-neutral-700 hover:bg-neutral-100", dotInactive: "#d4d4d8", dotActive: "var(--color-primary)" },
  dark:    { button: "border-white/20 text-white hover:bg-white/10",             dotInactive: "#ffffff40", dotActive: "var(--color-primary)" },
  primary: { button: "border-white/30 text-white hover:bg-white/15",             dotInactive: "#ffffff40", dotActive: "#ffffff" },
};

const nav = navThemes[background];
---

<Section {background} class="fadeUp" data-trig>
  <SectionHeader {eyebrow} {title} {description} {background} {align} class="max-w-4xl" />

  <div
    class="swiper"
    id={`${id}-swiper`}
    data-gallery-id={id}
    data-gallery-cols={cols}
    data-autoplay-delay={autoplayDelay}
    data-loop={String(loop)}
    data-space-between={spaceBetween}
  >
    <div class="swiper-wrapper">
      {photos.map((photo) => (
        <div class="swiper-slide">
          <a
            href={getSrc(photo.src)}
            class="glightbox block w-full overflow-hidden"
            data-gallery={id}
            data-description={photo.description}
          >
            {typeof photo.src === "string" ? (
              <img
                src={photo.src}
                alt={photo.alt}
                width={800}
                height={600}
                class="w-full aspect-img object-cover transition-transform duration-500 hover:scale-105"
              />
            ) : (
              <Image
                src={photo.src}
                alt={photo.alt}
                width={800}
                height={600}
                class="w-full aspect-img object-cover transition-transform duration-500 hover:scale-105"
              />
            )}
          </a>
          {photo.caption && (
            <p class="mt-2 text-sm text-neutral-500 text-center">{photo.caption}</p>
          )}
        </div>
      ))}
    </div>
  </div>

  <div class="mt-10 flex items-center justify-center gap-4">
    <button id={`${id}-prev`} type="button" aria-label="Foto anterior"
      class={`shrink-0 flex h-11 w-11 items-center justify-center border transition-all duration-200 active:scale-95 ${nav.button}`}>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6" />
      </svg>
    </button>

    <div id={`${id}-pagination`} class="pagination-el flex items-center gap-2" />

    <button id={`${id}-next`} type="button" aria-label="Próxima foto"
      class={`shrink-0 flex h-11 w-11 items-center justify-center border transition-all duration-200 active:scale-95 ${nav.button}`}>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 18 6-6-6-6" />
      </svg>
    </button>
  </div>
</Section>

<style define:vars={{ dotInactive: nav.dotInactive, dotActive: nav.dotActive, aspect }}>
  #swiper-wrapper { align-items: stretch; }

  .swiper :global(.swiper-slide) { height: auto; }

  .pagination-el :global(.swiper-pagination-bullet) {
    width: 6px; height: 6px;
    background: var(--dotInactive);
    opacity: 1; border-radius: 9999px;
    transition: all 0.3s; margin: 0 !important;
  }
  .pagination-el :global(.swiper-pagination-bullet-active) {
    width: 24px;
    background: var(--dotActive);
  }
  .pagination-el {
    position: static !important;
    width: auto !important;
    display: flex !important;
    align-items: center;
    gap: 0.5rem;
  }

  .swiper :global(.aspect-img) { aspect-ratio: var(--aspect); }

  .fadeUp { opacity: 0; transform: translateY(32px); }
  .fadeUp.trig { animation: fadeUp 0.9s ease-out forwards; }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(32px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  import { initGalleries, registerGalleryListeners } from "../scripts/gallery-swiper";
  registerGalleryListeners(); // registra astro:before-swap e astro:page-load uma única vez
  initGalleries();
</script>
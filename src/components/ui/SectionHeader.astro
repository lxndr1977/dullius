---
interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  align?: 'left' | 'center' | 'right';
  background?: 'white' | 'neutral' | 'dark' | 'primary' | 'transparent';
  titleSize?: 'base' | 'medium' | 'large';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'center',
  background = 'white',
  titleSize = 'large',
  class: className = 'mb-10',
  ...attrs
} = Astro.props;

const themes = {
  white: {
    eyebrow: 'text-primary',
    title: 'text-neutral-800',
    description: 'text-neutral-600',
  },
  transparent: {
    eyebrow: 'text-primary',
    title: 'text-neutral-800',
    description: 'text-neutral-600',
  },
  neutral: {
    eyebrow: 'text-primary',
    title: 'text-neutral-800',
    description: 'text-neutral-600',
  },
  dark: {
    eyebrow: 'text-primary',
    title: 'text-white',
    description: 'text-neutral-400',
  },
  primary: {
    eyebrow: 'text-white',
    title: 'text-white',
    description: 'text-white',
  },
};

const titleSizes = {
  base:   'text-2xl md:text-3xl lg:text-4xl tracking-tighter',
  medium: 'text-4xl md:text-5xl lg:text-6xl tracking-tighter',
  large:  'text-5xl md:text-6xl lg:text-7xl tracking-tighter',
};

const theme = themes[background];

const alignClass = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right',
}[align];

const descAlignClass = {
  left: 'mr-auto',
  center: 'mx-auto',
  right: 'ml-auto',
}[align];
---

<div class={` ${alignClass} ${className}`} {...attrs}>
  {eyebrow && (
    <p class={`text-sm font-semibold uppercase tracking-widest ${theme.eyebrow}`}>
      {eyebrow}
    </p>
  )}
  {title && (
    <h2 class={`mt-3 text-balance ${titleSizes[titleSize]} ${theme.title}`}>
      {title}
    </h2>
  )}
  {description && (
    <p class={`mt-4 max-w-2xl text-lg xl:text-xl leading-relaxed ${theme.description} ${descAlignClass}`}>
      {description}
    </p>
  )}
</div>
---
import {
  Thermometer,
  Zap,
  Wifi,
  Car,
  Sofa,
  Trees,
  Coffee,
  ShoppingBag,
  ArrowUpSquare,
  Flame,
  DoorOpen,
  Layers,
} from "@lucide/astro";

const features = [
  {
    title: "Ambiente climatizado",
    description: "Para garantir conforto em todas as estações do ano.",
    icon: Thermometer,
  },
  {
    title: "Gerador próprio",
    description:
      "Gerador próprio para garantir energia contínua durante as aulas.",
    icon: Zap,
  },
  {
    title: "Wi-Fi",
    description: "Conexão Wi-Fi gratuita para os alunos e familiares.",
    icon: Wifi,
  },
  {
    title: "Estacionamento",
    description: "Estacionamento exclusivo para os alunos e familiares.",
    icon: Car,
  },
  {
    title: "Lounge",
    description: "Área de lazer com conforto para os alunos e familiares.",
    icon: Sofa,
  },
  {
    title: "Pátio interno",
    description: "Pátio interno para atividades ao ar livre.",
    icon: Trees,
  },
  {
    title: "Café",
    description: "Café para os alunos e familiares.",
    icon: Coffee,
  },
  {
    title: "Shop",
    description: "Loja com produtos e acessórios para os alunos.",
    icon: ShoppingBag,
  },
  {
    title: "Elevador",
    description: "Elevador para facilitar o acesso aos andares.",
    icon: ArrowUpSquare,
  },
  {
    title: "Vestiários com piso aquecido",
    description: "Vestiários com piso aquecido para conforto térmico.",
    icon: Flame,
  },
  {
    title: "5 amplas salas",
    description: "5 amplas salas de aula para as atividades de dança.",
    icon: DoorOpen,
  },
  {
    title: "Pisos especiais",
    description: "Pisos flutuantes e flexíveis para proteção das articulações.",
    icon: Layers,
  },
];
---

<div
  class="max-w-7xl xl:container px-4 md:px-6 lg:px-8 mx-auto grid gap-8 sm:grid-cols-2 lg:grid-cols-4"
  data-animate="fadeInUp"
  data-animate-delay={0.3}
>
  {
    features.map((feature, index) => (
      <div class="feature-card bg-white border border-neutral-200 p-8 lg:p-10 flex flex-col justify-start fadeIn">
        <div class="flex items-center gap-4">
          <feature.icon class="w-5 h-5 text-primary shrink-0" />
        </div>
        <div class="mt-10">
          <h3 class="text-lg xl:text-xl font-medium text-neutral-800">
            {feature.title}
          </h3>
          <p class="mt-3 text-neutral-600 text-base leading-relaxed">
            {feature.description}
          </p>
        </div>
      </div>
    ))
  }
</div>

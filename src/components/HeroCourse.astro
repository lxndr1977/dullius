---
import { ArrowUpRight } from "@lucide/astro";
import Button from "./ui/Button.astro";
import Section from "./ui/Section.astro";

interface Props {
  id?: string;
  tag?: string;
  title?: string;
  description?: string;
  ctaText?: string;
  ctaHref?: string;
  imageSrc?: string;
  imageSrcset?: string;
  imagePosition?: string;
  paddingBottom?: boolean;
  paddingTop?: boolean;
}

const {
  id = "inicio",
  tag = "Dullius Dance",
  title = "Seu caminho para a excelência na dança",
  description = "Descubra o poder da dança em um ambiente que inspira movimento, arte e transformação. Com aulas para todas as idades e níveis, a Dullius Dance é o lugar onde sua paixão se encontra com a técnica.",
  ctaText = "Agende sua aula experimental",
  ctaHref = "https://dulliusdance.com.br",
  imageSrc = "https://cdn.prod.website-files.com/684f91df71b424da63a64df2/684f9eb0d0b3b34f086009cc_hero_igm.webp",
  imageSrcset = "",
  imagePosition = "center",
  paddingBottom = false,
  paddingTop = false,
} = Astro.props;

const objectPositionClass =
  imagePosition === "top"
    ? "object-top"
    : imagePosition === "bottom"
      ? "object-bottom"
      : imagePosition === "left"
        ? "object-left"
        : imagePosition === "right"
          ? "object-right"
          : "object-center";
---

<Section class="w-full" id={id} paddingBottom={paddingBottom} paddingTop={paddingTop}>
  <div
    class="pt-28 pb-12 lg:pt-36 md:pb-16 max-w-7xl mx-auto"
    data-animate="reveal"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-16 items-start">
      <div class="flex flex-col gap-3">
        <p class="text-sm font-semibold uppercase tracking-widest text-primary">
          {tag}
        </p>

        <h1
          class="text-6xl lg:text-7xl tracking-tighter leading-[1.1] text-neutral-800"
        >
          {title}
        </h1>
      </div>

      <div class="flex flex-col gap-8 md:gap-10">
        <p
          class="text-lg md:text-xl text-neutral-700 leading-relaxed"
        >
          {description}
        </p>

        <Button href={ctaHref}>
          <span class="ml-1">{ctaText}</span>
          <ArrowUpRight class="ml-1 h-5 w-5" />
        </Button>
      </div>
    </div>
  </div>

  <div class="max-w-7xl xl:container mx-auto">
    <div
      class="group relative w-full h-[65vh] md:h-[75vh] lg:h-[90vh] overflow-hidden rounded"
      data-animate="reveal"
      data-animate-delay="0.2"
    >
      <img
        src={imageSrc}
        srcset={imageSrcset}
        alt={title}
        class={`w-full h-full object-cover ${objectPositionClass} transition-transform duration-[1200ms] ease-out group-hover:scale-[1.04]`}
        loading="lazy"
      />

      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 via-black/5 to-transparent opacity-80 group-hover:opacity-100 transition-opacity duration-700"
      >
      </div>

      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,transparent,rgba(0,0,0,0.25))] opacity-40"
      >
      </div>
    </div>
  </div>
</Section>

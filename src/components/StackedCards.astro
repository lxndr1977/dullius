---
import Section from "./ui/Section.astro";
import SectionHeader from "./ui/SectionHeader.astro";

interface Item {
  image: string;
  alt?: string;
  title?: string;
  text?: string;
}

interface Props {
  items: Item[];
  eyebrow?: string;
  title?: string;
  description?: string;
  background?: "white" | "neutral" | "dark" | "primary" | "transparent";
  align?: "left" | "center" | "right";
}

const { items, eyebrow, title, description, background, align } = Astro.props;
---

<Section {background}>

  <div class="stacked-cards relative  mx-auto">
    {items.map((item, index) => (
      <div
        class="stacked-card sticky top-32 flex flex-col sm:flex-row gap-8 items-center bg-neutral-100 p-8 rounded"
        style={`z-index: ${10 + index};`}
      >
        <div class="w-full sm:w-1/2 aspect-[4/3] overflow-hidden shrink-0 rounded">
          <img
            src={item.image}
            alt={item.alt ?? item.title ?? ""}
            class="h-full w-full object-cover"
          />
        </div>

        {(item.title || item.text) && (
          <div class="w-full sm:w-1/2">
            {item.title && (
              <h3 class="text-2xl font-medium tracking-tight text-neutral-700">
                {item.title}
              </h3>
            )}
            {item.text && (
              <p class="mt-3 text-neutral-600 leading-relaxed">
                {item.text}
              </p>
            )}
          </div>
        )}
      </div>
    ))}
  </div>
</Section>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const cards = document.querySelectorAll<HTMLElement>(".stacked-card");

  cards.forEach((card, index) => {
    // Cada card que NÃO é o último escala para baixo enquanto o próximo sobe
    if (index < cards.length - 1) {
      gsap.to(card, {
        scale: 0.95 - index * 0.02, // escala progressiva
        ease: "none",
        scrollTrigger: {
          trigger: card,
          start: "top top+=96", // quando o card gruda no topo
          end: "bottom top+=96",
          scrub: true,
        },
      });
    }
  });
</script>

<style>
  .stacked-cards {
    /* Espaço entre cards para o scroll funcionar */
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .stacked-card {
    will-change: transform, filter;
    transform-origin: top center;
  }
</style>
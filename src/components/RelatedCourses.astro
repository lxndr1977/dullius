---
// RelatedCourses.astro
import Section from "./ui/Section.astro";
import SectionHeader from "./ui/SectionHeader.astro";

const id = `related-courses-${Math.random().toString(36).slice(2, 7)}`;

interface Course {
  title: string;
  description: string;
  image: string;
  age: string;
  href?: string;
}

interface Props {
  courses: Course[];
  eyebrow?: string;
  title?: string;
  description?: string;
  background?: "white" | "neutral" | "dark" | "primary" | "transparent";
  align?: "left" | "center" | "right";
}

const {
  courses,
  eyebrow,
  title, 
  description,
  background = "white",
  align = "left",
} = Astro.props;

const navThemes = {
  white:       { button: "border-neutral-200 text-neutral-700 hover:bg-neutral-100", dotInactive: "#d4d4d8", dotActive: "var(--color-primary)" },
  neutral:     { button: "border-neutral-200 text-neutral-700 hover:bg-neutral-100", dotInactive: "#d4d4d8", dotActive: "var(--color-primary)" },
  dark:        { button: "border-white/20 text-white hover:bg-white/10",             dotInactive: "#ffffff40", dotActive: "var(--color-primary)" },
  primary:     { button: "border-white/30 text-white hover:bg-white/15",             dotInactive: "#ffffff40", dotActive: "#ffffff" },
  transparent: { button: "border-neutral-200 text-neutral-700 hover:bg-neutral-100", dotInactive: "#d4d4d8", dotActive: "var(--color-primary)" },
};

const nav = navThemes[background] ?? navThemes.white;
---

<Section {background}>
  <SectionHeader {eyebrow} {title} {description} {background} {align}  />

  <div class="swiper related-courses-swiper-instance" id={`${id}-swiper`}>
    <div class="swiper-wrapper py-0.5">
      {
        courses.map((course) => (
          <div class="swiper-slide h-auto">
            <div class="group relative flex flex-col overflow-hidden border border-neutral-200 bg-white transition-transform duration-300 hover:-translate-y-2 h-full">

              {/* Imagem (topo) */}
              <div class="relative aspect-[4/3] overflow-hidden">
                <a href={course.href || "#contato"} tabindex="-1">
                  <img
                    src={course.image}
                    alt={course.title}
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-foreground/20 transition-all duration-300 group-hover:bg-foreground/40" />
                  <span class="absolute left-4 top-4 bg-white/10 px-3 py-1 text-xs font-medium text-white backdrop-blur-sm">
                    {course.age}
                  </span>
                </a>
              </div>

              {/* Conteúdo */}
              <div class="p-6 flex flex-col flex-1">
                <div class="flex-1">
                  <a href={course.href || "#contato"} class="block">
                    <h3 class="text-xl xl:text-3xl text-neutral-700 font-medium tracking-tight">
                      {course.title}
                    </h3>
                    {/* <p class="mt-2 xl:text-lg text-neutral-700 leading-relaxed">
                      {course.description}
                    </p> */}
                  </a>
                </div>

                {/* Botão */}
                <div class="mt-8">
                  <a
                    href={course.href || "#contato"}
                    class="group inline-flex items-center gap-2 text-sm font-semibold uppercase text-primary tracking-wider transition-all duration-300 ease-in-out relative"
                  >
                    <span class="relative after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-current after:transition-all after:duration-300 group-hover:after:w-full">
                      Saiba mais
                    </span>
                    <span class="transition-transform duration-300 group-hover:translate-x-3">→</span>
                  </a>
                </div>
              </div>

            </div>
          </div>
        ))
      }
    </div>
  </div>

  {/* Navegação */}
  <div class="mt-10 flex items-center justify-center gap-4">
    <button
      id={`${id}-prev`}
      type="button"
      class={`flex h-11 w-11 items-center justify-center border transition-all duration-200 active:scale-95 ${nav.button}`}
      aria-label="Curso anterior"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6" />
      </svg>
    </button>

    <div
      id={`${id}-pagination`}
      class="related-courses-pagination-instance flex items-center justify-center gap-2 w-auto"
    />

    <button
      id={`${id}-next`}
      type="button"
      class={`flex h-11 w-11 items-center justify-center border transition-all duration-200 active:scale-95 ${nav.button}`}
      aria-label="Próximo curso"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 18 6-6-6-6" />
      </svg>
    </button>
  </div>
</Section>

<style define:vars={{ dotInactive: nav.dotInactive, dotActive: nav.dotActive }}>
  .related-courses-swiper-instance :global(.swiper-wrapper) {
    align-items: stretch;
  }

  .related-courses-swiper-instance :global(.swiper-slide) {
    height: auto;
  }

  .related-courses-pagination-instance :global(.swiper-pagination-bullet) {
    width: 6px;
    height: 6px;
    background: var(--dotInactive);
    opacity: 1;
    border-radius: 9999px;
    transition: all 0.3s;
    margin: 0 !important;
  }

  .related-courses-pagination-instance {
    position: static !important;
    width: auto !important;
    display: flex !important;
    align-items: center;
    gap: 0.5rem;
  }

  .related-courses-pagination-instance :global(.swiper-pagination-bullet-active) {
    width: 24px;
    background: var(--dotActive);
  }
</style>

<script define:vars={{ id }}>
  window.__relatedCoursesIds = window.__relatedCoursesIds || {};
  window.__relatedCoursesIds[id] = true;
  document.currentScript.dataset.relatedCoursesId = id;
</script>

<script>
  import Swiper from "swiper";
  import { Navigation, Pagination, Autoplay, A11y } from "swiper/modules";
  import "swiper/css";

  Array.from(document.getElementsByTagName("script")).forEach((script) => {
    const id = script.dataset.relatedCoursesId;
    if (!id) return;

    const swiper = new Swiper(`#${id}-swiper`, {
      autoHeight: false,
      modules: [Navigation, Pagination, Autoplay, A11y],
      slidesPerView: 1.125,
      spaceBetween: 16,
      breakpoints: {
        640:  { slidesPerView: 2, spaceBetween: 20 },
        1024: { slidesPerView: 4, spaceBetween: 24 },
      },
      loop: true,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      pagination: {
        el: `#${id}-pagination`,
        clickable: true,
      },
      navigation: {
        prevEl: `#${id}-prev`,
        nextEl: `#${id}-next`,
      },
      a11y: {
        prevSlideMessage: "Curso anterior",
        nextSlideMessage: "Próximo curso",
      },
    });

    // Oculta a navegação (setas + dots) quando não há slides suficientes
    const syncNavVisibility = () => {
      const paginationEl = document.getElementById(`${id}-pagination`);
      const navRow = paginationEl?.closest<HTMLElement>(".mt-10");
      if (navRow) navRow.style.display = swiper.isLocked ? "none" : "";
    };

    swiper.on("lock", syncNavVisibility);
    swiper.on("unlock", syncNavVisibility);
    swiper.on("resize", syncNavVisibility);
    syncNavVisibility();
  });
</script>
---
// Footer.astro
const links = {
  cursos: [
    { label: "Método Dullius", href: "/modalidades/metodo-dullius" },
    { label: "Ballet", href: "/modalidades/ballet" },
    { label: "Jazz", href: "/modalidades/jazz" },
    { label: "Danças Urbanas", href: "/modalidades/dancas-urbanas" },
    { label: "Adulto", href: "/modalidades/adulto" },
    { label: "AcroDance", href: "/modalidades/acrodance" },
  ],
  escola: [
    { label: "Sobre a Dullius Dance", href: "/sobre" },
    { label: "Infraestrutura", href: "/infraestrutura" },
    { label: "Equipe", href: "/equipe" },
    { label: "Eventos", href: "/eventos" },
    { label: "Contato", href: "/contato" },
  ],
};

const currentYear = new Date().getFullYear();
---

<footer id="contato" class="bg-neutral-50 border-t border-border border-neutral-100">
  <div class="mx-auto max-w-7xl xl:container px-6 py-16 lg:py-28">
    <div class="flex flex-col gap-12 lg:flex-row lg:justify-between">
      <!-- Brand (left, wider) -->
      <div class="lg:max-w-md w-full">
        <img src="/logo-dullius-dance.svg" alt="Dullius Dance" class="h-24" />
        <p class="mt-6 text-neutral-700 leading-relaxed">
          Escola de Danca em Porto Alegre. Formando dançarinos e artistas há mais de 40 anos. Viva essa Magia!
        </p>
        <div class="mt-6 flex gap-4">
          <a
            href="https://www.instagram.com/dulliusdance/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary transition-colors hover:text-primary/90"
            aria-label="Instagram"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
          </a>

          <a
            href="https://www.facebook.com/dulliusdance"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary transition-colors hover:text-primary/90"
            aria-label="Facebook"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
              ></path>
            </svg>
          </a>

          <a
            href="https://www.youtube.com/@dulliusdance"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary transition-colors hover:text-primary/90"
            aria-label="YouTube"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"
              ></path>
              <path d="m10 15 5-3-5-3z"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Link columns (right, grouped) -->
      <div class="lg:max-w-1/2 grid grid-cols-1 gap-8 sm:grid-cols-3">
        <!-- Cursos -->
        <div>
          <h3
            class="text-sm font-semibold uppercase tracking-widest text-neutral-700"
          >
            Cursos
          </h3>
          <ul class="mt-4 flex flex-col gap-3">
            {
              links.cursos.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-neutral-700 transition-colors hover:text-neutral-700"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Escola -->
        <div>
          <h3
            class="text-sm font-semibold uppercase tracking-widest text-neutral-700"
          >
            Escola
          </h3>
          <ul class="mt-4 flex flex-col gap-3">
            {
              links.escola.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-neutral-700 transition-colors hover:text-neutral-700"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Contato -->
        <div>
          <h3
            class="text-sm font-semibold uppercase tracking-widest text-neutral-700"
          >
            Contato
          </h3>
          <ul class="mt-4 flex flex-col gap-4">
            <li>
              <a
                href="tel:5198594793"
                class="flex items-center gap-3 text-lg xl:text-xl text-neutral-700 font-medium transition-colors hover:text-neutral-700"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4 shrink-0 text-primary"
                >
                  <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                  ></path>
                </svg>
                <span class="font-semibold">(51) 98594.7939</span>
              </a>
            </li>
            <li>
              <a
                href="tel:5133349098"
                class="flex items-center gap-3 text-lg xl:text-xl text-neutral-700 font-medium transition-colors hover:text-neutral-700"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4 shrink-0 text-primary"
                >
                  <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                  ></path>
                </svg>
                <span class="font-semibold">(51) 3334.9098</span>
              </a>
            </li>
            <li>
              <a
                href="mailto:dance@dulliusdance.com.br"
                class="flex items-center gap-3 text-neutral-700 transition-colors hover:text-neutral-700"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4 shrink-0 text-primary"
                >
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
                dance@dulliusdance.com.br
              </a>
            </li>
            <li class="flex items-start gap-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4 shrink-0 text-primary"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span class="text-sm text-neutral-700">
                Av. Teixeira Mendes, 712<br />
                Porto Alegre/RS
              </span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-border border-neutral-200">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center justify-center gap-4 px-6 py-6 sm:flex-row"
    >
      <p class="text-sm text-neutral-700">
        &copy; {currentYear} Dullius Dance. CNPJ 99.999.999/00001-99. Todos os direitos
        reservados.
      </p>
    </div>
  </div>
</footer>
